// All report measures in one block for Power BI's DAX query view.
// 1. Create an empty table called _Measures first (Home > Enter data > name it _Measures > Load).
//    Not plain 'Measures': that name is reserved by the engine and queries cannot find it.
// 2. Open DAX query view (left bar, 4th icon), paste this whole file, press Run (F5).
// 3. Click "Update model with changes" above the query to add every measure to the _Measures table.
// 4. The result grid should match SQL Server: Availability % 0.8012, Lines Out All Day 181,791,
//    Stores Below Target 433, DQ Rows Failed 49,819. If it does, the model and relationships are right.

DEFINE
    MEASURE '_Measures'[Trading Hours] = COUNTROWS ( fact_daily_sales ) * 16
    MEASURE '_Measures'[OOS Hours] = SUM ( fact_daily_sales[oos_hours] )
    MEASURE '_Measures'[Availability %] = 1 - DIVIDE ( [OOS Hours], [Trading Hours] )
    MEASURE '_Measures'[Sale Units] = SUM ( fact_daily_sales[sale_units] )
    MEASURE '_Measures'[Lines Out All Day] =
        CALCULATE ( COUNTROWS ( fact_daily_sales ), fact_daily_sales[oos_hours] = 16 )
    MEASURE '_Measures'[Lines With A Gap] =
        CALCULATE ( COUNTROWS ( fact_daily_sales ), fact_daily_sales[oos_hours] > 0 )
    MEASURE '_Measures'[Gap Rate %] = DIVIDE ( [Lines With A Gap], COUNTROWS ( fact_daily_sales ) )
    MEASURE '_Measures'[Availability % Prev Week] =
        CALCULATE ( [Availability %], DATEADD ( dim_date[dt], -7, DAY ) )
    MEASURE '_Measures'[Change vs previous week] = [Availability %] - [Availability % Prev Week]
    MEASURE '_Measures'[Availability Target] = 0.8
    MEASURE '_Measures'[Stores Below Target] =
        COUNTROWS ( FILTER ( VALUES ( dim_store[store_id] ), [Availability %] < [Availability Target] ) )
    MEASURE '_Measures'[Promo Availability %] =
        CALCULATE ( [Availability %], fact_daily_sales[promo_flag] = TRUE () )
    MEASURE '_Measures'[DQ Rows Failed] =
        CALCULATE ( SUM ( dq_results[rows_failed] ), dq_results[run_at] = MAX ( dq_results[run_at] ) )

    // Colour for conditional formatting (Format > Cell elements / Bars > fx > Field value).
    // Red below the 80% target, amber within 2 points above it (watch list), green from 82%.
    MEASURE '_Measures'[Availability Colour] =
        VAR a = [Availability %]
        RETURN
            SWITCH (
                TRUE (),
                ISBLANK ( a ), BLANK (),
                a < [Availability Target], "#C0392B",
                a < [Availability Target] + 0.02, "#E0A43A",
                "#2E8B57"
            )

EVALUATE
    ROW (
        "Availability %", [Availability %],
        "Lines Out All Day", [Lines Out All Day],
        "Stores Below Target", [Stores Below Target],
        "DQ Rows Failed", [DQ Rows Failed]
    )

// Second result: the colour each category gets (red below target, amber within 2 points, green above).
EVALUATE
    SUMMARIZECOLUMNS (
        dim_product[first_category_id],
        "Availability %", [Availability %],
        "Colour", [Availability Colour]
    )
